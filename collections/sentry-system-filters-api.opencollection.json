{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sentry Alerts Filters API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Filters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sentry List a project's data filters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sentry.io/api/0/projects/:organization_id_or_slug/:project_id_or_slug/filters/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              },
              {
                "name": "project_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the project."
              }
            ]
          },
          "docs": "Returns a list of active inbound data filters for a project."
        },
        {
          "info": {
            "name": "Sentry Update an inbound data filter",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://sentry.io/api/0/projects/:organization_id_or_slug/:project_id_or_slug/filters/:filter_id/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              },
              {
                "name": "project_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the project."
              },
              {
                "name": "filter_id",
                "value": "",
                "type": "path",
                "description": "The ID of the filter to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a project's inbound data filter."
        }
      ]
    }
  ],
  "bundled": true
}