            "url": "https://sentry.io/api/0/organizations/:organization_id_or_slug/external-users/:external_user_id/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              },
              {
                "name": "external_user_id",
                "value": "",
                "type": "path",
