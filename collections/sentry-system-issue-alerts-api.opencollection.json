{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sentry Alerts Issue Alerts API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
