{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sentry Alerts User Feedback API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Feedback",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sentry List a project's user feedback",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sentry.io/api/0/projects/:organization_id_or_slug/:project_id_or_slug/user-feedback/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              },
              {
                "name": "project_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the project."
              }
            ]
          },
          "docs": "Returns a list of user feedback items for a project."
        },
        {
          "info": {
            "name": "Sentry Submit user feedback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sentry.io/api/0/projects/:organization_id_or_slug/:project_id_or_slug/user-feedback/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              },
              {
                "name": "project_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the project."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits a new user feedback item for a project."
        }
      ]
    }
  ],
  "bundled": true
}