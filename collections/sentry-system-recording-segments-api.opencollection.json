{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sentry Alerts Recording Segments API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Recording Segments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sentry List recording segments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sentry.io/api/0/projects/:organization_id_or_slug/:project_id_or_slug/replays/:replay_id/recording-segments/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              },
              {
                "name": "project_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the project."
              },
              {
                "name": "replay_id",
                "value": "",
                "type": "path",
                "description": "The ID of the replay."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor."
              }
            ]
          },
          "docs": "Returns a list of recording segments for a given replay."
        },
        {
          "info": {
            "name": "Sentry Retrieve a recording segment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sentry.io/api/0/projects/:organization_id_or_slug/:project_id_or_slug/replays/:replay_id/recording-segments/:segment_id/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              },
              {
                "name": "project_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the project."
              },
              {
                "name": "replay_id",
                "value": "",
                "type": "path",
                "description": "The ID of the replay."
              },
              {
                "name": "segment_id",
                "value": "",
                "type": "path",
                "description": "The ID of the recording segment."
              }
            ]
          },
          "docs": "Returns a specific recording segment."
        }
      ]
    }
  ],
  "bundled": true
}