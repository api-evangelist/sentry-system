{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sentry Alerts Tokens API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sentry Retrieve a paginated list of repository tokens for a given owner",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sentry.io/api/0/organizations/:organization_id_or_slug/prevent/tokens/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor."
              }
            ]
          },
          "docs": "Returns repository upload tokens."
        },
        {
          "info": {
            "name": "Sentry Regenerate a repository upload token and return the new token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sentry.io/api/0/organizations/:organization_id_or_slug/prevent/tokens/regenerate/",
            "params": [
              {
                "name": "organization_id_or_slug",
                "value": "",
                "type": "path",
                "description": "The ID or slug of the organization."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Regenerates a repository upload token."
        }
      ]
    }
  ],
  "bundled": true
}