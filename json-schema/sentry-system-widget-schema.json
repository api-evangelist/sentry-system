{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Widget",
  "title": "Widget",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "displayType": {
      "type": "string",
      "enum": [
        "line",
        "area",
        "stacked_area",
        "bar",
        "table",
        "big_number",
        "top_n"
      ]
    },
    "interval": {
      "type": "string"
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "string"
          },
          "orderby": {
            "type": "string"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        },
        "minH": {
          "type": "integer"
        }
      }
    }
  },
  "required": [
    "title",
    "displayType",
    "queries"
  ]
}