{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ScimUser",
  "title": "ScimUser",
  "type": "object",
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "properties": {
        "givenName": {
          "type": "string"
        },
        "familyName": {
          "type": "string"
        }
      }
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "primary": {
            "type": "boolean"
          },
          "value": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "active": {
      "type": "boolean"
    },
    "meta": {
      "type": "object",
      "properties": {
        "resourceType": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "id",
    "userName",
    "active"
  ]
}