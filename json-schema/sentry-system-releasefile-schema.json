{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ReleaseFile",
  "title": "ReleaseFile",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "sha1": {
      "type": "string"
    },
    "dist": {
      "type": "string",
      "nullable": true
    },
    "size": {
      "type": "integer"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time"
    },
    "headers": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "name"
  ]
}