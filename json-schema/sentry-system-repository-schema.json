{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Repository",
  "title": "Repository",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "nullable": true
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time"
    },
    "externalSlug": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ]
}