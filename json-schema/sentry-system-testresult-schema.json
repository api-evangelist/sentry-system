{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/TestResult",
  "title": "TestResult",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "error"
      ]
    },
    "duration": {
      "type": "number",
      "description": "Duration in seconds."
    },
    "suite": {
      "type": "string"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "name",
    "status"
  ]
}