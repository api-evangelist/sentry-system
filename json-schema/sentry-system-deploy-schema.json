{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Deploy",
  "title": "Deploy",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "nullable": true
    },
    "url": {
      "type": "string",
      "nullable": true
    },
    "dateStarted": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    },
    "dateFinished": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    }
  },
  "required": [
    "id",
    "environment"
  ]
}