{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ServiceHook",
  "title": "ServiceHook",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "secret": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "url",
    "events"
  ]
}