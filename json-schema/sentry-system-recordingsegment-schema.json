{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/RecordingSegment",
  "title": "RecordingSegment",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "replayId": {
      "type": "string",
      "format": "uuid"
    },
    "segmentId": {
      "type": "integer"
    },
    "dateAdded": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "segmentId"
  ]
}