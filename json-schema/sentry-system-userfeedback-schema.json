{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/UserFeedback",
  "title": "UserFeedback",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "eventID": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "comments": {
      "type": "string"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "eventID",
    "comments"
  ]
}